# Copy to server/.env and fill in. Never commit the real file.
ZKVAULT_ENVIRONMENT=production
ZKVAULT_DATABASE_URL=postgresql+psycopg://zkvault:CHANGE_ME@localhost/zkvault

# Generate each with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ZKVAULT_JWT_SECRET=
ZKVAULT_ENUMERATION_SECRET=

ZKVAULT_ACCESS_TOKEN_TTL_SECONDS=900
ZKVAULT_REFRESH_TOKEN_TTL_SECONDS=2592000
ZKVAULT_MAX_BLOB_BYTES=16777216
ZKVAULT_RATE_LIMIT_AUTH_PER_MINUTE=10
ZKVAULT_RATE_LIMIT_SYNC_PER_MINUTE=60
ZKVAULT_REQUIRE_HTTPS=true

# Comma-separated, exact origins. Leave empty unless a browser client exists.
ZKVAULT_CORS_ORIGINS=
