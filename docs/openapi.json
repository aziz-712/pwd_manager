      "put": {
        "description": "Optimistic concurrency: the write is accepted only if the client's base\nversion still matches the stored one. Otherwise 409 with the server version,\nand the client re-downloads, merges locally, and retries.\n\nLast-writer-wins would be the easy alternative and would silently destroy an\nentry added on another device -- unacceptable for this data.",
        "operationId": "upload_api_v1_vault_put",
        "parameters": [
          {
            "description": "Optional belt and braces: the same number as `base_version`, quoted, e.g. `\"3\"`.",
            "in": "header",
            "name": "If-Match",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional belt and braces: the same number as `base_version`, quoted, e.g. `\"3\"`.",
              "title": "If-Match"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VaultPutIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VaultMetaOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Empty blob, malformed If-Match, or If-Match disagreeing with base_version."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Missing, expired or rejected credentials."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConflictOut"
                }
              }
            },
            "description": "base_version is stale. Re-download, merge locally, and retry."
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Blob exceeds ZKVAULT_MAX_BLOB_BYTES."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Rate limit exceeded. Honour the Retry-After header."
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Upload a new version",
        "tags": [
          "vault"
        ]
      }
    },
